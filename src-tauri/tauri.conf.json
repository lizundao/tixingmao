{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "提醒猫",
  "version": "0.1.0",
  "identifier": "com.tixingmao.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "提醒猫",
        "width": 1040,
        "height": 720,
        "minWidth": 780,
        "minHeight": 560,
        "center": true,
        "visible": true,
        "decorations": true,
        "resizable": true
      },
      {
        "label": "overlay",
        "url": "index.html#/overlay",
        "title": "提醒猫",
        "width": 440,
        "height": 360,
        "visible": false,
        "focus": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "shadow": false,
        "noRedirectionBitmap": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "到点时让一只小猫咪来提醒你",
    "longDescription": "提醒猫是一款安静驻留托盘的桌面提醒工具。它支持法定工作日、节假日跳过、一次性与循环提醒，并在到点时显示可暂停的动画猫咪。"
  }
}

