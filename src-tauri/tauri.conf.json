{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tixingmao",
  "version": "1.0.1",
  "identifier": "com.tixingmao.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "提醒猫",
        "width": 1040,
        "height": 720,
        "minWidth": 780,
        "minHeight": 560,
        "center": true,
        "visible": true,
        "decorations": true,
        "resizable": true,
        "dragDropEnabled": false
      },
      {
        "label": "overlay",
        "url": "index.html#/overlay",
        "title": "提醒猫",
        "width": 440,
        "height": 360,
        "visible": false,
        "focus": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "shadow": false,
        "noRedirectionBitmap": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["SimpChinese", "English"]
      }
    },
    "shortDescription": "到点时让一只小猫咪来提醒你",
    "longDescription": "安静驻留托盘的桌面提醒工具，支持法定工作日、节假日跳过与动画猫咪悬浮提醒",
    "category": "Utility",
    "copyright": "Copyright © lizundao"
  }
}
